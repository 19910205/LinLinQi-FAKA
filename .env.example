# Copy to .env, keep it chmod 600, and replace every replace-* value before production.
# Use URL-safe random values (for example `openssl rand -hex 32`) because the
# PostgreSQL password is embedded in DATABASE_URL by docker-compose.yml.
APP_ENV=production
# Native macOS deployment binds the API to loopback. Compose overrides this
# with 0.0.0.0 inside its private network namespace.
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_JWT_SECRET=replace-with-a-different-32-character-secret
DATA_ENCRYPTION_KEY=replace-with-a-kms-managed-32-character-secret
OPENAPI_KEY=linlinqi_live_replace
OPENAPI_SECRET=replace-with-an-openapi-hmac-secret
METRICS_TOKEN=replace-with-a-prometheus-bearer-token

# Production bootstrap is opt-in. Set a one-time strong password only while
# BOOTSTRAP_ADMIN=true, then clear it and recreate the containers.
BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DATA=false

WORKER_CONCURRENCY=12
REDIS_DB=0
# Bound Redis so queue/rate-limit writes fail closed before the host is OOM-killed.
# Size this above normal queue/AOF working set and monitor rejected writes.
REDIS_MAXMEMORY=512mb

# Durable content-addressed product media. Compose uses the container path
# below; native macOS run-native-macos.sh defaults to ~/.linlinqi/storage.
# The public base URL must end at /media and use HTTPS in production.
STORAGE_ROOT=/var/lib/linlinqi/storage
MEDIA_PUBLIC_BASE_URL=https://api.example.com/media
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_STORAGE_MAX_BYTES=214748364800
MEDIA_MIN_FREE_BYTES=107374182400
# Native macOS maintenance jobs. These do not contain credentials.
NATIVE_BACKUP_RETENTION_DAYS=14
NATIVE_LOG_MAX_BYTES=52428800
NATIVE_LOG_RETENTION_DAYS=14
APP_URL=https://api.example.com
# Optional distinct public API origin for supplier callbacks. When empty in
# production, APP_URL is used.
SUPPLIER_CALLBACK_URL=
USER_APP_URL=https://store.example.com
SUPPORT_EMAIL=support@example.com
CORS_ORIGINS=https://store.example.com,https://admin.example.com

# Keep empty when there is no trusted reverse proxy. Never use 0.0.0.0/0.
TRUSTED_PROXIES=

# Frontend API endpoints are compiled into the static bundles at image build.
PUBLIC_USER_API_URL=https://api.example.com/api/v1
PUBLIC_ADMIN_API_URL=https://api.example.com/admin/v1

# Base Compose binds HTTP only to loopback. Terminate TLS in a reverse proxy on
# the same host and proxy to these ports. Change BIND_ADDRESS only deliberately.
BIND_ADDRESS=127.0.0.1
# ── Service ports — SINGLE SOURCE OF TRUTH ──────────────────────────────
# To change ports, edit ONLY these values (then restart services).
#   APP_PORT             API listen port
#   API_PUBLISHED_PORT   API published port (Compose)
#   USER_PUBLISHED_PORT  Storefront port (Vite dev / Compose publish)
#   ADMIN_PUBLISHED_PORT Admin console port (Vite dev / Compose publish)
APP_PORT=8081
API_PUBLISHED_PORT=8081
USER_PUBLISHED_PORT=8080
ADMIN_PUBLISHED_PORT=8082
DEV_BIND_ADDRESS=127.0.0.1
# Use the immutable release identifier from the build/publish pipeline. Never
# deploy a moving tag such as latest to production.
LINLINQI_IMAGE_TAG=replace-with-release-version

# Optional provider-neutral notification relay. If URL is set in production,
# the API requires HTTPS and a relay secret of at least 32 characters.
NOTIFICATION_RELAY_URL=
NOTIFICATION_RELAY_SECRET=

# Optional provider-neutral OpenID Connect providers. JSON is passed directly
# to the API process; keep this file chmod 600 in production.
OAUTH_PROVIDERS_JSON={}
