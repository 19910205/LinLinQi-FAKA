APP_ENV=development
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_URL=http://localhost:8080
# Public API origin used by upstream suppliers for signed delivery callbacks.
# Leave empty in development to use polling only.
SUPPLIER_CALLBACK_URL=
USER_APP_URL=http://localhost:5173
SUPPORT_EMAIL=support@linlinqi.local
DATABASE_URL=postgres://linlinqi:linlinqi@localhost:5432/linlinqi?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_CONCURRENCY=12
STORAGE_ROOT=./var/storage
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_STORAGE_MAX_BYTES=214748364800
MEDIA_MIN_FREE_BYTES=1073741824
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_JWT_SECRET=change-this-to-another-long-random-secret
DATA_ENCRYPTION_KEY=change-this-to-a-random-32-byte-or-longer-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_PROXIES=
SEED_DATA=true
BOOTSTRAP_ADMIN=true
BOOTSTRAP_ADMIN_PASSWORD=LinLinQi@2026
OPENAPI_KEY=linlinqi_demo_key
OPENAPI_SECRET=linlinqi_demo_secret_change_me
METRICS_TOKEN=dev-metrics-token-change-me-123456
NOTIFICATION_RELAY_URL=
NOTIFICATION_RELAY_SECRET=

# Optional provider-neutral OpenID Connect providers. Keep secrets out of source
# control. Production issuers must be public HTTPS URLs.
OAUTH_PROVIDERS_JSON={}
